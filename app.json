{
  "expo": {
    "name": "sandip ko AI",
    "slug": "sandip-ko-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voidkii.sandipkoai"
    },
    "android": {
      "package": "com.voidkii.sandipkoai",
      "adaptiveIcon": {
        "backgroundColor": "#F5F2EB"
      }
    },
    "plugins": [
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production",
          "forceCxx20": true,
          "enableOpenCL": false
        }
      ]
    ]
  }
}
